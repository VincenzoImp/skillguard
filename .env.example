SKILLGUARD_API_URL=http://localhost:8787
SKILLGUARD_CONNECTION_ID=conn-demo
SKILLGUARD_RUN_ID=local-demo
SKILLGUARD_SITE_HOST=127.0.0.1
SKILLGUARD_SITE_PORT=5173
# Real-wallet agent submissions require an Ed25519 agent key.
# Generate one with: node scripts/generate-agent-key.mjs
# SKILLGUARD_AGENT_PRIVATE_KEY_B58=replace-me

# Android packaging.
# Use `debug` for local install, `standalone` for a release-mode APK signed
# with the generated Android debug key, or `release` for a release-mode APK
# signed with a private upload keystore supplied outside git.
SKILLGUARD_ANDROID_BUILD_PROFILE=debug
# SKILLGUARD_ANDROID_KEYSTORE_PATH=/absolute/path/to/skillguard-upload.jks
# SKILLGUARD_ANDROID_KEYSTORE_PASSWORD=replace-me
# SKILLGUARD_ANDROID_KEY_ALIAS=skillguard-upload
# SKILLGUARD_ANDROID_KEY_PASSWORD=replace-me
